# ---------------------------------------------------------------------------
# apps/backend — copy to .env and fill in. NEVER commit the filled-in file.
# Every variable below is validated at boot (src/config/env.ts); a bad value
# stops the process instead of starting a half-configured API.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# PostgreSQL 16. Use `pnpm db:up` with Docker or `pnpm db:local` without it.
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance?schema=public

# 32+ chars. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-development-only-secret-value-32chars

# Access token lives in memory on the client and is deliberately short.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lives in an HttpOnly cookie and rotates on every use. 30 days.
REFRESH_TOKEN_TTL_SECONDS=2592000

# Exact origins allowed to call the API with credentials, comma separated.
CORS_ORIGINS=http://localhost:3000

# Drives "today", month/week boundaries and the recurrence job.
APP_TIMEZONE=America/Sao_Paulo

# Session cookie. In production COOKIE_SECURE MUST be true.
# Use SameSite=none + Secure only when the frontend is on a different site.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Import limits
MAX_UPLOAD_BYTES=5242880
MAX_IMPORT_ROWS=5000
IMPORT_BATCH_TTL_MINUTES=60

# Backup restore payload limit
MAX_BACKUP_BYTES=20971520

# Toggles
ENABLE_CRON=true
ENABLE_SWAGGER=true

# Only used by `pnpm --filter backend test:integration`. When unset, the test
# harness boots a throwaway PostgreSQL 16 via `embedded-postgres` (no Docker).
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/finance_test
