{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "pnpm --filter @finance/contracts build",
    "build": "nest build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prestart": "pnpm --filter @finance/contracts build",
    "start": "nest start",
    "prestart:dev": "pnpm --filter @finance/contracts build",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "pnpm --filter @finance/contracts build",
    "start:prod": "node dist/main.js",
    "lint": "biome check --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @finance/contracts build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "pretest:e2e": "pnpm --filter @finance/contracts build",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "pretest:integration": "pnpm --filter @finance/contracts build",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "dev": "nest start --watch"
  },
  "dependencies": {
    "@finance/contracts": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.4.1",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.7.1",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.2.3",
    "embedded-postgres": "16.14.0-beta.17",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pg": "^8.16.3",
    "prisma": "^7.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*.spec.ts$",
    "transform": {
      "^.+.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/generated/**",
      "!**/*.module.ts",
      "!main.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/generated/"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
