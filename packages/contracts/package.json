{
  "name": "@finance/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Single source of truth for the HTTP contract shared by apps/backend and apps/frontend.",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
